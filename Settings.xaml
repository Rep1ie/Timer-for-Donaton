<Window x:Class="Timer_for_Donaton.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:Timer_for_Donaton"
        mc:Ignorable="d"
        Title="Настройки" Height="524" Width="500" ResizeMode="NoResize" Icon="/icon_settings.png" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
    <Grid>
        <Border BorderThickness="0" HorizontalAlignment="Center" Height="94" Margin="0,108,0,0" VerticalAlignment="Top" Width="500" Background="#FFF1F1F1"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" Height="437">
            <Label Content="Cсылка на виджет Donation Alerts:" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="16" Width="272" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/tooltip_icon.png" Width="20" Height="28.5">
                    <Image.ToolTip>
                        <ToolTip Width="459" Height="378">
                            <StackPanel>
                                <TextBlock Text="Ссылка на виджет оповещений DonationAlerts находится на Боковой панели -> Виджеты -> Оповещения -> Показать ссылку для встраивания" FontFamily="Arial" Foreground="Black" FontSize="16" TextWrapping="Wrap" Margin="3,0,3,5"/>
                                <Image Source="/Resources/widget_tooltip.png" Width="459" Height="300"/>
                            </StackPanel>
                        </ToolTip>
                    </Image.ToolTip>
                </Image>
                <PasswordBox x:Name="DALink_PasswordBox" HorizontalAlignment="Left" Password="" VerticalAlignment="Center" Width="272" Height="28.5" Foreground="Black" Padding="4, 5, 4, 3" Margin="4, 0"/>
                <Button x:Name="ConnectDA_Button" Content="Подключить" VerticalAlignment="Center" FontFamily="Arial" FontSize="16" Height="28.5" Width="112" Background="White" HorizontalAlignment="Center" Margin="4,0,0,0" Click="ConnectDA_Button_Click"/>
            </StackPanel>

            <Label Content="Начисление времени за деньги:" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial" FontSize="16" Width="250" Margin="0,30,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" Width="416">
                <TextBox x:Name="PlusTime_TextBox" HorizontalAlignment="Left" Text="600" VerticalAlignment="Top" Width="60" FontFamily="Arial" FontSize="16" Foreground="Black" Padding="4, 4, 4, 3" Height="28.4"/>
                <Label Content="секунд" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="16"/>
                <Label Content="=" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" Width="162" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="2"/>
                <TextBox x:Name="MinusMoney_TextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="60" FontFamily="Arial" FontSize="16" Foreground="Black" Padding="4, 4, 4, 3" Height="28.4" Margin="10,0,0,0" Text="140"/>
                <Label Content="рублей" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="16" Width="63"/>
            </StackPanel>

            <Label Content="Настройка внешнего вида таймера:" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial" FontSize="16" Margin="0,30,0,0" Width="277" HorizontalContentAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Label Content="Шрифт:" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="16" Padding="1, 5, 5, 5"/>
                    <ComboBox x:Name="Font_ComboBox" Width="192" FontFamily="Arial" FontSize="16" Height="28.4" Padding="4, 4, 4, 3" IsEditable="True" VerticalAlignment="Top" HorizontalAlignment="Left" Text="Arial"/>
                </StackPanel>
                <StackPanel Margin="3,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Label Content="Цвет текста:" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="16" Padding="1, 5, 5, 5" Margin="23,0,0,0"/>
                    <ComboBox x:Name="TextColor_ComboBox" SelectedValuePath="Content" Width="100" FontFamily="Arial" FontSize="16" Height="28.4" Padding="4, 4, 4, 3" VerticalAlignment="Top" HorizontalAlignment="Left" IsEditable="True" Text="Белый">
                        <ComboBoxItem Content="Прозрачный"/>
                        <ComboBoxItem Content="Черный"/>
                        <ComboBoxItem Content="Белый"/>
                        <ComboBoxItem Content="Серый"/>
                        <ComboBoxItem Content="Желтый"/>
                        <ComboBoxItem Content="Оранжевый"/>
                        <ComboBoxItem Content="Красный"/>
                        <ComboBoxItem Content="Розовый"/>
                        <ComboBoxItem Content="Фиолетовый"/>
                        <ComboBoxItem Content="Синий"/>
                        <ComboBoxItem Content="Голубой"/>
                        <ComboBoxItem Content="Зеленый"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Label Content="Размер контура:" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="16" Padding="1, 5, 5, 5"/>
                <ComboBox x:Name="BorderSize_ComboBox" SelectedValuePath="Content" Width="64" FontFamily="Arial" FontSize="16" Height="28.4" Padding="4, 4, 4, 3" VerticalAlignment="Top" HorizontalAlignment="Left" Text="0" IsEditable="True">
                    <ComboBoxItem Content="0"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="20"/>
                </ComboBox>
                <Label Content="Цвет контура:" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="16" Margin="11,0,0,0"/>
                <ComboBox x:Name="BorderColor_ComboBox" SelectedValuePath="Content" Width="100" FontFamily="Arial" FontSize="16" Height="28.4" Padding="4, 4, 4, 3" VerticalAlignment="Center" HorizontalAlignment="Center" IsEditable="True" Text="Нет">
                    <ComboBoxItem Content="Нет"/>
                    <ComboBoxItem Content="Черный"/>
                    <ComboBoxItem Content="Белый"/>
                    <ComboBoxItem Content="Серый"/>
                    <ComboBoxItem Content="Желтый"/>
                    <ComboBoxItem Content="Оранжевый"/>
                    <ComboBoxItem Content="Красный"/>
                    <ComboBoxItem Content="Розовый"/>
                    <ComboBoxItem Content="Фиолетовый"/>
                    <ComboBoxItem Content="Синий"/>
                    <ComboBoxItem Content="Голубой"/>
                    <ComboBoxItem Content="Зеленый"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Image Source="/Resources/tooltip_icon.png" Width="20" Height="28.5">
                    <Image.ToolTip>
                        <ToolTip Width="473" Height="440">
                            <StackPanel>
                                <TextBlock Text="Чтобы таймер отображался в OBS нужно Создать новый источник -> Браузер -> вставить ссылку в URL-адрес" FontFamily="Arial" Foreground="Black" FontSize="16" TextWrapping="Wrap" Margin="3,0,3,5"/>
                                <Image Source="/Resources/obslink_tooltip.png" Width="473" Height="400"/>
                            </StackPanel>
                        </ToolTip>
                    </Image.ToolTip>
                </Image>
                <Button x:Name="CreateOBSLink_Button" Content="Отобразить таймер в OBS" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="16" Height="31" Width="217" Background="White" Click="CreateOBSLink_Button_Click" Margin="4,0,4,0"/>
                <TextBox x:Name="OBSLink_TextBox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="136" FontFamily="Arial" FontSize="17" Height="31" Foreground="Black" Padding="4, 4.5, 4, 3" Margin="4,0,0,0" BorderThickness="1,1,0,1" BorderBrush="#FF7F7F7F" MouseDoubleClick="OBSLink_TextBox_MouseDoubleClick"/>
                <Button x:Name="CopyOBSLink_Button" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="16" Height="31" Width="31" Background="White" Click="CopyOBSLink_Button_Click">
                    <Image x:Name="CopyImage" Source="/Resources/icon_copy.png" Width="16"/>
                </Button>
            </StackPanel>

            <Button x:Name="SaveSettings_Button" Content="Сохранить" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="Arial" FontSize="16" Height="34" Width="105" Background="White" Margin="0,25,0,0" Click="SaveSettings_Button_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
