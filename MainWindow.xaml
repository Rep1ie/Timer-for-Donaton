<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Timer_for_Donaton"
        x:Class="Timer_for_Donaton.MainWindow"
        mc:Ignorable="d"
        Title="Таймер для Донатона" Height="450" Width="676"
        ResizeMode="CanMinimize" WindowStyle="None" AllowsTransparency="False"
        FontFamily="Segoe UI" Icon="/Resources/TimerIcon.png"
        Closing="Window_Closing"
        Background="{DynamicResource Brush.Window.Background}" WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ Кастомный тайтлбар ============ -->
            <Grid Grid.Row="0" Background="{DynamicResource Brush.Titlebar}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="/Resources/TimerIcon.png" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Таймер для Донатона" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="Theme_Button" Style="{StaticResource CaptionButton}" Click="Theme_Click" ToolTip="Переключить тему">
                        <Path x:Name="ThemeIcon" Data="{StaticResource Icon.Moon}" Fill="{DynamicResource Brush.Icon}"
                              Stretch="Uniform" Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Свернуть">
                        <Path Data="{StaticResource Icon.Minimize}" Fill="{DynamicResource Brush.Icon}"
                              Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonClose}" Click="Close_Click" ToolTip="Закрыть">
                        <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.Icon}"
                              Stretch="Uniform" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Основное содержимое ============ -->
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0">
                    <Button x:Name="MinusTime_Button" Content="−" VerticalAlignment="Center" Height="36" Width="40" FontSize="20"/>
                    <TextBox x:Name="PlusMinusTime_TextBox" VerticalAlignment="Center" Width="80" FontSize="18" Height="36"
                             VerticalContentAlignment="Center" TextAlignment="Center" Text="50" Margin="6,0"/>
                    <ComboBox x:Name="Currency_ComboBox" SelectedValuePath="Content" Width="48" FontSize="18" Height="36"
                              VerticalAlignment="Center" SelectedValue="Ч">
                        <ComboBoxItem Content="Ч"/>
                        <ComboBoxItem Content="м"/>
                        <ComboBoxItem Content="с"/>
                        <ComboBoxItem Content="₽"/>
                    </ComboBox>
                    <Button x:Name="PlusTime_Button" Content="+" VerticalAlignment="Center" Height="36" Width="40" FontSize="20" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBox x:Name="Timer_TextBox" IsReadOnly="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Width="420" TextAlignment="Center" FontSize="72" Text="00:00:00" Margin="0,0,0,35"
                         VerticalContentAlignment="Center"/>

                <Button Style="{StaticResource CircularButton}" x:Name="StartTimer" HorizontalAlignment="Center"
                        Height="54" Width="54" Click="StartTimer_Click" VerticalAlignment="Bottom" Margin="0,0,0,90">
                    <Path x:Name="StartIcon" Data="{StaticResource Icon.Play}" Fill="{DynamicResource Brush.Accent.Text}"
                          Stretch="Uniform" Width="26" Height="26"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Grid VerticalAlignment="Bottom" Height="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Logs" Grid.Column="0" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                            Height="40" Width="40" Margin="10" Click="LogsWindow_Click" ToolTip="Логи">
                        <Path Data="{StaticResource Icon.Logs}" Fill="{DynamicResource Brush.Icon}"
                              Stretch="Uniform" Width="22" Height="22"/>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label x:Name="DAStatus_Label" Content="DonationAlerts не подключен!" HorizontalContentAlignment="Center"
                               FontSize="15" Foreground="{DynamicResource Brush.Status.Error}"/>
                        <Label x:Name="DPStatus_Label" Content="DonatePay не подключен!" HorizontalContentAlignment="Center"
                               FontSize="15" Foreground="{DynamicResource Brush.Status.Error}"/>
                    </StackPanel>

                    <Button x:Name="Settings" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                            Height="40" Width="40" Margin="10" Click="Settings_Click" ToolTip="Настройки">
                        <Path Data="{StaticResource Icon.Settings}" Fill="{DynamicResource Brush.Icon}"
                              Stretch="Uniform" Width="22" Height="22"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
