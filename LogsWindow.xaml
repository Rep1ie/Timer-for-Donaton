<Window x:Class="Timer_for_Donaton.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Timer_for_Donaton"
        mc:Ignorable="d"
        Title="Логи" Height="460" Width="800" FontFamily="Segoe UI" Icon="/Resources/logs_icon.jpg"
        ResizeMode="CanResizeWithGrip" WindowStyle="None" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ Кастомный тайтлбар ============ -->
            <Grid Grid.Row="0" Background="{DynamicResource Brush.Titlebar}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Path Data="{StaticResource Icon.Logs}" Fill="{DynamicResource Brush.Icon}" Stretch="Uniform"
                          Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Логи" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Свернуть">
                        <Path Data="{StaticResource Icon.Minimize}" Fill="{DynamicResource Brush.Icon}"
                              Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonClose}" Click="Close_Click" ToolTip="Закрыть">
                        <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.Icon}"
                              Stretch="Uniform" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Список логов ============ -->
            <Border Grid.Row="1" Margin="16,14,16,0" CornerRadius="4"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1">
                <ScrollViewer x:Name="Logs_ScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="8,6">
                    <ItemsControl x:Name="Logs_ItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource IconButton}" Width="26" Height="26"
                                            Margin="0,0,8,0" VerticalAlignment="Top" Click="Rollback_Click"
                                            Visibility="{Binding IsDonation, Converter={StaticResource BoolToVis}}"
                                            IsEnabled="{Binding CanRollback}"
                                            ToolTip="{Binding RollbackTooltip}">
                                        <Path Data="{StaticResource Icon.Undo}" Fill="{DynamicResource Brush.Icon}"
                                              Opacity="{Binding RollbackIconOpacity}"
                                              Stretch="Uniform" Width="16" Height="16"/>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding Color}"
                                               TextDecorations="{Binding TextDecorations}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ============ Нижняя панель ============ -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10,16,14">
                <Button x:Name="ClearLogs_Button" Content="Очистить историю" FontSize="14" Height="32" Width="160"
                        Click="ClearLogs_Click" ToolTip="Удалить все записи логов (без возможности восстановления)"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
