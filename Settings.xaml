<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Timer_for_Donaton"
        x:Class="Timer_for_Donaton.Settings"
        mc:Ignorable="d"
        Title="Настройки" Height="720" Width="520" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="False" Icon="/Resources/icon_settings.png"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
        Background="{DynamicResource Brush.Window.Background}" FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ Кастомный тайтлбар ============ -->
            <Grid Grid.Row="0" Background="{DynamicResource Brush.Titlebar}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Path Data="{StaticResource Icon.Settings}" Fill="{DynamicResource Brush.Icon}" Stretch="Uniform"
                          Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Настройки" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonClose}" Click="Close_Click" ToolTip="Закрыть">
                        <Path Data="{StaticResource Icon.Close}" Fill="{DynamicResource Brush.Icon}"
                              Stretch="Uniform" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Содержимое ============ -->
            <StackPanel Grid.Row="1" Margin="26,16,26,16">

                <!-- DonationAlerts -->
                <Label Content="Ссылка на виджет Donation Alerts:" FontSize="16" Padding="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Info}" Fill="{DynamicResource Brush.Icon.Muted}" Stretch="Uniform"
                          Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Help">
                        <Path.ToolTip>
                            <ToolTip Width="459" Height="378">
                                <StackPanel>
                                    <TextBlock Text="Ссылка на виджет оповещений DonationAlerts находится на Боковой панели -&gt; Виджеты -&gt; Оповещения -&gt; Показать ссылку для встраивания" FontFamily="Segoe UI" FontSize="16" TextWrapping="Wrap" Margin="3,0,3,5"/>
                                    <Image Source="/Resources/widget_tooltip.png" Width="459" Height="300"/>
                                </StackPanel>
                            </ToolTip>
                        </Path.ToolTip>
                    </Path>
                    <PasswordBox x:Name="DALink_PasswordBox" Password="" VerticalAlignment="Center" Width="300" Height="30" Padding="4,5,4,3"/>
                    <Button x:Name="ConnectDA_Button" Content="Подключить" VerticalAlignment="Center" FontSize="15" Height="30" Width="110" Margin="8,0,0,0" Click="ConnectDA_Button_Click"/>
                </StackPanel>

                <!-- DonatePay -->
                <Label Content="API-токен DonatePay:" FontSize="16" Padding="0,0,0,4" Margin="0,14,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Info}" Fill="{DynamicResource Brush.Icon.Muted}" Stretch="Uniform"
                          Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Help">
                        <Path.ToolTip>
                            <ToolTip Width="459" Height="120">
                                <StackPanel>
                                    <TextBlock Text="API-токен DonatePay находится на странице https://donatepay.ru/page/api . Вставьте именно токен (Access Token), а не ссылку на виджет." FontFamily="Segoe UI" FontSize="16" TextWrapping="Wrap" Margin="3"/>
                                </StackPanel>
                            </ToolTip>
                        </Path.ToolTip>
                    </Path>
                    <PasswordBox x:Name="DPLink_PasswordBox" Password="" VerticalAlignment="Center" Width="300" Height="30" Padding="4,5,4,3"/>
                    <Button x:Name="ConnectDP_Button" Content="Подключить" VerticalAlignment="Center" FontSize="15" Height="30" Width="110" Margin="8,0,0,0" Click="ConnectDP_Button_Click"/>
                </StackPanel>

                <!-- Начисление времени -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="12,10" Margin="0,20,0,0">
                    <StackPanel>
                        <Label Content="Начисление времени за деньги:" FontSize="16" Padding="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="PlusTime_TextBox" Text="600" Width="64" FontSize="16" Padding="4,4,4,3" Height="30" VerticalContentAlignment="Center"/>
                            <Label Content="секунд" FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <Label Content="=" FontSize="20" Width="120" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="MinusMoney_TextBox" Text="140" Width="64" FontSize="16" Padding="4,4,4,3" Height="30" VerticalContentAlignment="Center"/>
                            <Label Content="рублей" FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Внешний вид таймера -->
                <Label Content="Настройка внешнего вида таймера:" FontSize="16" Padding="0" Margin="0,18,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Шрифт:" FontSize="16" Padding="0,0,0,4"/>
                        <ComboBox x:Name="Font_ComboBox" Width="200" FontSize="16" Height="30" Padding="4,4,4,3" IsEditable="True" HorizontalAlignment="Left" Text="Arial"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <Label Content="Цвет текста:" FontSize="16" Padding="0,0,0,4"/>
                        <ComboBox x:Name="TextColor_ComboBox" SelectedValuePath="Content" Width="140" FontSize="16" Height="30" Padding="4,4,4,3" HorizontalAlignment="Left" IsEditable="True" Text="Белый">
                            <ComboBoxItem Content="Проз��ачный"/>
                            <ComboBoxItem Content="Черный"/>
                            <ComboBoxItem Content="Белый"/>
                            <ComboBoxItem Content="Серый"/>
                            <ComboBoxItem Content="Желтый"/>
                            <ComboBoxItem Content="Оранжевый"/>
                            <ComboBoxItem Content="Красный"/>
                            <ComboBoxItem Content="Розовый"/>
                            <ComboBoxItem Content="Фиолетовый"/>
                            <ComboBoxItem Content="Синий"/>
                            <ComboBoxItem Content="Голубой"/>
                            <ComboBoxItem Content="Зеленый"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel>
                        <Label Content="Размер контура:" FontSize="16" Padding="0,0,0,4"/>
                        <ComboBox x:Name="BorderSize_ComboBox" SelectedValuePath="Content" Width="80" FontSize="16" Height="30" Padding="4,4,4,3" HorizontalAlignment="Left" Text="0" IsEditable="True">
                            <ComboBoxItem Content="0"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="15"/>
                            <ComboBoxItem Content="20"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="16,0,0,0">
                        <Label Content="Цвет контура:" FontSize="16" Padding="0,0,0,4"/>
                        <ComboBox x:Name="BorderColor_ComboBox" SelectedValuePath="Content" Width="140" FontSize="16" Height="30" Padding="4,4,4,3" HorizontalAlignment="Left" IsEditable="True" Text="Нет">
                            <ComboBoxItem Content="Нет"/>
                            <ComboBoxItem Content="Черный"/>
                            <ComboBoxItem Content="Белый"/>
                            <ComboBoxItem Content="Серый"/>
                            <ComboBoxItem Content="Желтый"/>
                            <ComboBoxItem Content="Оранжевый"/>
                            <ComboBoxItem Content="Красный"/>
                            <ComboBoxItem Content="Розовый"/>
                            <ComboBoxItem Content="Фиолетовый"/>
                            <ComboBoxItem Content="Синий"/>
                            <ComboBoxItem Content="Голубой"/>
                            <ComboBoxItem Content="Зеленый"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- OBS -->
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Info}" Fill="{DynamicResource Brush.Icon.Muted}" Stretch="Uniform"
                          Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Help">
                        <Path.ToolTip>
                            <ToolTip Width="473" Height="440">
                                <StackPanel>
                                    <TextBlock Text="Чтобы таймер отображался в OBS нужно Создать новый источник -&gt; Браузер -&gt; вставить ссылку в URL-адрес" FontFamily="Segoe UI" FontSize="16" TextWrapping="Wrap" Margin="3,0,3,5"/>
                                    <Image Source="/Resources/obslink_tooltip.png" Width="473" Height="400"/>
                                </StackPanel>
                            </ToolTip>
                        </Path.ToolTip>
                    </Path>
                    <Button x:Name="CreateOBSLink_Button" Content="Отобразить таймер в OBS" VerticalAlignment="Center" FontSize="15" Height="32" Width="210" Click="CreateOBSLink_Button_Click"/>
                    <TextBox x:Name="OBSLink_TextBox" VerticalAlignment="Center" Width="150" FontSize="15" Height="32" Padding="4,4.5,4,3" Margin="8,0,0,0" VerticalContentAlignment="Center" MouseDoubleClick="OBSLink_TextBox_MouseDoubleClick"/>
                    <Button x:Name="CopyOBSLink_Button" VerticalAlignment="Center" Height="32" Width="36" Margin="6,0,0,0" Click="CopyOBSLink_Button_Click" ToolTip="Копировать ссылку">
                        <Path Data="{StaticResource Icon.Copy}" Fill="{DynamicResource Brush.Icon}" Stretch="Uniform" Width="18" Height="18"/>
                    </Button>
                </StackPanel>

                <!-- Автоподключение при запуске -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="14,12" Margin="0,18,0,0">
                    <CheckBox x:Name="AutoConnect_CheckBox" VerticalContentAlignment="Center"
                              ToolTip="При старте программа сама подключится к сохранённым сервисам DonationAlerts и DonatePay и запустит сервер OBS.">
                        <StackPanel>
                            <TextBlock Text="Подключать автоматически при запуске" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Text="DonationAlerts, DonatePay и сервер OBS подключатся сами — заходить сюда каждый раз не нужно."
                                       FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- Сохранить -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Ellipse x:Name="SaveIndicator" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0"
                             Fill="{DynamicResource Brush.Status.Success}"/>
                    <Button x:Name="SaveSettings_Button" Content="Сохранить" FontSize="16" Height="36" Width="120" Click="SaveSettings_Button_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
